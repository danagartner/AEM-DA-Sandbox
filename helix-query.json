# Query indices.
#
# Two indices with distinct jobs:
#   • `published` → /query-index.json — generic, whole-site, lean. Drives the XML sitemap and is
#     available for any site-wide listing/search. Deliberately carries no blog-specific columns.
#
# Docs: https://www.aem.live/developer/indexing
version: 1

indices:
  # ── Generic whole-site index (sitemap + general use) ─────────────────────
  published:
    include:
      - '/**'
    exclude:
      - '/drafts/**'
      - '/fragments/**'
      - '/tools/**'
      - '/nav'
      - '/footer'
      - '/placeholders'
      - '/metadata'
    target: /query-index.json
    properties:
      title:
        select: head > meta[property="og:title"]
        value: attribute(el, 'content')

  animals:
    include:
      - '/animals/**'
    exclude:
      - '/drafts/**'
      - '/fragments/**'
      - '/tools/**'
      - '/nav'
      - '/footer'
      - '/placeholders'
      - '/metadata'
    target: /animals/animals-index.json
    properties:
      title:
        select: head > meta[property="og:title"]
        value: attribute(el, 'content')
